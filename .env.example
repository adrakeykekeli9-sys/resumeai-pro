# ── IA (obligatoire) ──
# Clé API Claude : https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=""
# Modèle (facultatif). Par défaut claude-opus-5-5. Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5
AI_MODEL=""
# Effort de réflexion : low (défaut, économique), medium, high
AI_EFFORT=""

# ── Paiement Chariow (obligatoire pour vendre des Pass) ──
# Clé API Chariow avec les droits licenses.read et licenses.write (app.chariow.com → Paramètres → Clés API)
CHARIOW_API_KEY=""
# Identifiants des produits "Pass" acceptés, séparés par des virgules (ex : prd_abc,prd_def). Vide = toutes les licences de la boutique
CHARIOW_PRODUCT_IDS=""
# Lien de votre page de vente Chariow
PASS_BUY_URL=""
# Offres affichées : Nom|Prix|Description ; séparées par des points-virgules
PASS_PRICES="Pass 7 jours|1 000 FCFA|Pour préparer une candidature;Pass 30 jours|2 500 FCFA|Le plus choisi;Pass Recruteur 30 jours|10 000 FCFA|Tri et classement de candidats"

# ── Limites ──
FREE_DAILY_ACTIONS=3     # essais IA gratuits par jour et par appareil
PASS_DAILY_ACTIONS=60    # plafond quotidien par Pass (anti-partage)
FREE_GRACE_CALLS=6       # appels déclenchés par un même clic, comptés comme une seule action

# Clés de test qui fonctionnent sans Chariow (à laisser vide en production)
DEV_PASS_KEYS=""
